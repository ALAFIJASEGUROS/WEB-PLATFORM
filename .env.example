# URL pública del sitio (enlaces en correos, sitemap, redirección de Wompi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firma de la cookie de sesión. Obligatorio en producción.
SESSION_SECRET=

# Acceso a /admin: correos con rol (admin = cambios, analista = solo lectura).
# Se entra con el código por correo. Sin esta variable, /admin solo abre fuera de producción.
ADMIN_EMAILS=ana@empresa.co:admin,luis@empresa.co:analista

# Wompi (sandbox: llaves pub_test_...). Sin estas tres variables se usa la pasarela simulada.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Secreto que Vercel envía al cron de recordatorios.
CRON_SECRET=

# Proveedor de correo (pendiente). Sin él, el código OTP se muestra en pantalla.
RESEND_API_KEY=
