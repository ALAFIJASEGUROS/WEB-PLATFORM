# URL pública del sitio (enlaces en correos, sitemap, redirección de Wompi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firma de la cookie de sesión. Obligatorio en producción.
SESSION_SECRET=

# Acceso a /admin: correos con rol (admin = cambios, analista = solo lectura).
# Se entra con el código por correo. Sin esta variable, /admin solo abre fuera de producción.
ADMIN_EMAILS=ana@empresa.co:admin,luis@empresa.co:analista

# Wompi (sandbox: llaves pub_test_...). Sin estas tres variables se usa la pasarela simulada.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Pasarela para cobros nuevos si hay varias configuradas (por defecto, la primera). Ver docs/pasarelas.md
PAYMENT_PROVIDER=

# Secreto que Vercel envía al cron de recordatorios.
CRON_SECRET=

# Proveedor de correo (pendiente). Sin él, el código OTP se muestra en pantalla.
RESEND_API_KEY=

# Seguros Bolívar (ver docs/bolivar.md). mock (por defecto) | sandbox | prod.
# Para probar en local contra el sandbox falso: BOLIVAR_API_URL=http://localhost:3000/api/sandbox/bolivar,
# BOLIVAR_TOKEN_URL=<esa URL>/oauth/token, BOLIVAR_CLIENT_ID=sandbox-client, BOLIVAR_CLIENT_SECRET=sandbox-secret.
INSURER_BOLIVAR_MODE=mock
BOLIVAR_API_URL=
BOLIVAR_TOKEN_URL=
BOLIVAR_CLIENT_ID=
BOLIVAR_CLIENT_SECRET=
BOLIVAR_INTERMEDIARY_CODE=
# Figura legal: agencia (por defecto) | corredor | corresponsalia_digital
BOLIVAR_CONTRACT_MODEL=
BOLIVAR_QUOTE_TIMEOUT_MS=
# Habilita /api/sandbox/bolivar fuera de desarrollo (solo previews; nunca en producción).
FAKE_BOLIVAR_SANDBOX=

# Portal de aseguradoras (/aliados): correo:aseguradora separados por coma.
# Sin esta variable, fuera de producción entra aliado@bolivar-demo.co (demo).
INSURER_PORTAL_USERS=
